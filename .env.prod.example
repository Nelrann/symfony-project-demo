# Production environment variables template
# Copy this file to .env.prod.local on the server and fill in the secrets.
# NEVER commit .env.prod.local to version control.

###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://example.com
###< symfony/routing ###

###> deployment ###
# Domain used by Caddy for automatic HTTPS
DOMAIN=example.com
# Host ports exposed by Caddy. Use 80/443 only if they are free on the server.
WEB_HTTP_PORT=8081
WEB_HTTPS_PORT=8443
###< deployment ###

###> deployment db ###
# Database credentials used by docker-compose.prod.yml
DB_NAME=symfony
DB_USER=symfony
DB_PASSWORD=CHANGE_ME_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
###< deployment db ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://symfony:CHANGE_ME_PASSWORD@db:3306/symfony?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=smtp://user:password@smtp.example.com:587
###< symfony/mailer ###
