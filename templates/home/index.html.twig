{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}
{% block meta_description %}Stack Symfony 7.4, PHP 8.3-FPM, MySQL 8, nginx + Caddy HTTPS, AssetMapper &amp; Tailwind CSS v4 — déploiement Docker en une commande.{% endblock %}

{% block body %}
<div class="relative isolate overflow-hidden">

    {# ===== Halos décoratifs ===== #}
    <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[520px] overflow-hidden" aria-hidden="true">
        <div class="absolute -top-40 left-1/2 -translate-x-1/2 rounded-full bg-brand/15 blur-3xl" style="width: 860px; height: 420px;"></div>
        <div class="absolute top-24 -left-32 h-72 w-72 rounded-full bg-sky-200/40 blur-3xl"></div>
        <div class="absolute top-40 -right-28 h-72 w-72 rounded-full bg-blue-200/40 blur-3xl"></div>
    </div>

    {# ===== Header ===== #}
    <header class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6">
        <div class="flex items-center gap-2.5">
            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand text-white shadow-lg shadow-brand/30">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5"/>
                </svg>
            </span>
            <span class="text-lg font-semibold tracking-tight text-slate-900">symfony<span class="text-brand">-project</span></span>
        </div>
        <nav class="hidden items-center gap-8 text-sm font-medium text-slate-600 sm:flex">
            <a href="#stack" class="transition hover:text-slate-900">La stack</a>
            <a href="#features" class="transition hover:text-slate-900">Fonctionnalités</a>
            <a href="#deploy" class="transition hover:text-slate-900">Déployer</a>
        </nav>
        <div class="flex items-center gap-3">
            <a href="https://github.com/Nelrann/symfony-project" target="_blank" rel="noopener noreferrer" aria-label="Dépôt GitHub du projet"
               class="flex h-9 w-9 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-600 shadow-sm transition hover:border-slate-900 hover:text-slate-900">
                <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.04 11.04 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/>
                </svg>
            </a>
            <a href="{{ path('app_home') }}" class="hidden rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:border-brand hover:text-brand sm:inline-block">
                Accueil
            </a>
        </div>
    </header>

    {# ===== Hero ===== #}
    <main class="mx-auto max-w-6xl px-6">
        <section class="pb-24 pt-16 sm:pt-24">
            <div class="mx-auto max-w-3xl text-center">
                <p class="animate-fade-up inline-flex items-center gap-2 rounded-full border border-brand-soft bg-white/70 px-4 py-1.5 text-sm font-medium text-brand-dark shadow-sm backdrop-blur">
                    <span class="relative flex h-2 w-2">
                        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                        <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
                    </span>
                    En ligne · HTTPS automatique
                </p>

                <h1 class="animate-fade-up mt-6 text-4xl font-bold tracking-tight text-slate-900 sm:text-6xl [animation-delay:80ms]">
                    Votre stack Symfony,
                    <span class="bg-gradient-to-r from-brand via-blue-600 to-sky-500 bg-clip-text text-transparent">prête pour la production</span>
                </h1>

                <p class="animate-fade-up mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-600 [animation-delay:160ms]">
                    Un socle complet et moderne : Symfony 7.4, PHP 8.3-FPM, MySQL 8, nginx,
                    HTTPS automatique via Caddy et Tailwind CSS v4 sans Node ni npm.
                </p>

                <div class="animate-fade-up mt-10 flex flex-wrap items-center justify-center gap-4 [animation-delay:240ms]">
                    <a href="#deploy"
                       class="inline-flex items-center gap-2 rounded-xl bg-brand px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-brand/30 transition hover:bg-brand-dark hover:shadow-brand/40">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0l-4-4m4 4l4-4"/><path d="M5 21h14"/></svg>
                        Déployer en 1 commande
                    </a>
                    <a href="#features"
                       class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-brand hover:text-brand">
                        Découvrir la stack
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m0 0l-6-6m6 6l-6 6"/></svg>
                    </a>
                    <a href="https://github.com/Nelrann/symfony-project" target="_blank" rel="noopener noreferrer"
                       class="inline-flex items-center gap-2.5 rounded-xl bg-slate-900 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-slate-900/20 transition hover:bg-slate-700">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.04 11.04 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/>
                        </svg>
                        Voir le code source
                    </a>
                </div>

                <div class="animate-fade-up mt-12 flex flex-wrap items-center justify-center gap-2.5 [animation-delay:320ms]">
                    {% set chips = ['Symfony 7.4', 'PHP 8.3 FPM', 'MySQL 8', 'nginx + Caddy', 'Tailwind v4', 'AssetMapper', 'OPcache', 'Doctrine ORM'] %}
                    {% for chip in chips %}
                        <span class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 font-mono text-xs font-medium text-slate-600 shadow-sm">{{ chip }}</span>
                    {% endfor %}
                </div>
            </div>
        </section>

        {# ===== Features ===== #}
        <section id="features" class="scroll-mt-10 pb-24">
            <div class="mx-auto max-w-2xl text-center">
                <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Tout est déjà branché</h2>
                <p class="mt-4 text-lg text-slate-600">
                    Chaque brique de prod est configurée, testée et réversible — il ne reste qu'à écrire votre application.
                </p>
            </div>

            <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {% set features = [
                    {
                        icon: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="M12 12l8-4.5M12 12v9M12 12L4 7.5"/>',
                        title: 'HTTPS automatique',
                        desc: "Les certificats Let's Encrypt sont provisionnés par Caddy et renouvelés tout seuls. Reverse-proxy vers nginx → PHP-FPM.",
                    },
                    {
                        icon: '<path d="M4 6h16v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6Z"/><path d="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2H4V6Z"/><path d="M8 14l2.5 2.5L15 12"/>',
                        title: 'Deploy en une commande',
                        desc: './deploy.sh : pull du code, build --pull des images, migrations Doctrine, tailwind, cache prod et reload FPM.',
                    },
                    {
                        icon: '<path d="M3 12c3-6 9-6 12 0 3-6 6-4 6-4"/><path d="M3 12v3a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-3"/><path d="M5 19v2m14-2v2"/>',
                        title: 'Tailwind sans Node',
                        desc: 'CSS compilé par le binaire Tailwind v4 via AssetMapper — aucun npm, aucun bundler, styles servus statiquement avec cache 1 an.',
                    },
                    {
                        icon: '<path d="M12 8c-1.7-1.7-4.5-1.5-6 .5S5 13.5 7 15s5 1 6-1c1.2 2 4 2.2 5.7.5s1.6-4.5-.2-6.3S13.7 6.3 12 8Z"/><circle cx="12" cy="12" r="9"/>',
                        title: 'OPcache + preload',
                        desc: 'validate_timestamps à 0, preload du kernel, autoloader optimisé en classmap authoritative : le FPM est chaud dès le démarrage.',
                    },
                    {
                        icon: '<path d="M4 7V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2"/><path d="M2 11h20v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6Z"/><path d="M6 15h4"/>',
                        title: 'Console & diagnostics',
                        desc: 'router:match, debug:container, doctrine:migrations… tout passe par un exec docker sain, avec DOTENV prod isolé.',
                    },
                    {
                        icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="M9 12l2 2 4-4"/>',
                        title: 'Sécurité suivie',
                        desc: 'build --pull à chaque deploy pour propager les correctifs PHP/OS (CVE appliqués automatiquement), headers HTTP durcis.',
                    },
                ] %}
                {% for feature in features %}
                    <article class="group rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-brand/40 hover:shadow-lg hover:shadow-slate-200/60">
                        <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-soft text-brand transition group-hover:bg-brand group-hover:text-white">
                            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                {{ feature.icon|raw }}
                            </svg>
                        </div>
                        <h3 class="mt-5 text-lg font-semibold text-slate-900">{{ feature.title }}</h3>
                        <p class="mt-2 leading-relaxed text-slate-600">{{ feature.desc }}</p>
                    </article>
                {% endfor %}
            </div>
        </section>

        {# ===== Deploy ===== #}
        <section id="deploy" class="scroll-mt-10 pb-24">
            <div class="grid items-center gap-10 rounded-3xl border border-slate-200 bg-white p-8 shadow-sm sm:p-12 lg:grid-cols-2">
                <div>
                    <h2 class="text-3xl font-bold tracking-tight text-slate-900">Du local à la prod, sans friction</h2>
                    <p class="mt-4 leading-relaxed text-slate-600">
                        Une seule commande gère le build, les migrations, le CSS Tailwind,
                        le cache de prod et le restart FPM. Vous éditez, vous poussez, c'est en ligne.
                    </p>
                    <ul class="mt-6 space-y-3 text-sm text-slate-600">
                        {% for step in ['git push — la source est versionnée', './deploy.sh — build + warmup + reload', 'curl → 200 — le site est à jour'] %}
                            <li class="flex items-start gap-3">
                                <svg class="mt-0.5 h-5 w-5 flex-none text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
                                <span>{{ step }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </div>

                <div class="overflow-hidden rounded-2xl bg-slate-900 shadow-xl ring-1 ring-slate-900/10">
                    <div class="flex items-center gap-1.5 border-b border-slate-800 px-4 py-3">
                        <span class="h-3 w-3 rounded-full bg-red-400"></span>
                        <span class="h-3 w-3 rounded-full bg-amber-400"></span>
                        <span class="h-3 w-3 rounded-full bg-emerald-400"></span>
                        <span class="ml-3 font-mono text-xs text-slate-500">terminal — serveur de prod</span>
                    </div>
                    <pre class="overflow-x-auto p-5 font-mono text-[13px] leading-relaxed"><code><span class="text-slate-500">$</span> <span class="text-emerald-300">./deploy.sh</span>
<span class="text-slate-500">==&gt; Domain: symfony-project.nelrann.org</span>
<span class="text-slate-500">==&gt; Pulling latest code...</span> <span class="text-amber-300">main ✓</span>
<span class="text-slate-500">==&gt; Building production images...</span> <span class="text-amber-300">symfony-prod-php ✓</span>
<span class="text-slate-500">==&gt; Starting services...</span> <span class="text-emerald-300">healthy ✓</span>
<span class="text-slate-500">==&gt; Migrations + tailwind + cache...</span> <span class="text-emerald-300">ok ✓</span>
<span class="text-slate-500">==&gt; Reload php-fpm (opcache)...</span> <span class="text-emerald-300">done ✓</span>
<span class="text-slate-500">$</span> <span class="text-slate-400">curl -sI https://symfony-project.nelrann.org | head -1</span>
<span class="text-blue-300">HTTP/2 200</span></code></pre>
                </div>
            </div>
        </section>
    </main>

    {# ===== Footer ===== #}
    <footer class="border-t border-slate-200 bg-white">
        <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm text-slate-500 sm:flex-row">
            <p>© {{ 'now'|date('Y') }} symfony-project — propulsé par Docker</p>
            <div class="flex items-center gap-6">
                <a href="https://github.com/Nelrann/symfony-project" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 transition hover:text-slate-900">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M12 .5A11.5 11.5 0 0 0 .5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.04 11.04 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/>
                    </svg>
                    GitHub
                </a>
                <a href="https://nelrann.org" class="transition hover:text-slate-900">nelrann.org</a>
                <span class="h-1 w-1 rounded-full bg-slate-300"></span>
                <span class="font-mono text-xs">env = {{ app.environment }}</span>
            </div>
        </div>
    </footer>

    {% if app.environment == 'dev' %}
    <p class="pb-6 text-center">
        <a href="{{ path('_profiler_home') }}" class="text-xs text-slate-400 underline hover:text-slate-600">WDT home (dev)</a>
    </p>
    {% endif %}
</div>
{% endblock %}
